# ── Auth ────────────────────────────────────────────────────────────
# MUST match backend JWT_SECRET exactly — same secret, shared auth
JWT_SECRET=change_me_strong_secret_min_32_chars
JWT_ALGORITHM=HS256

# ── AI Provider ─────────────────────────────────────────────────────
# Supported: openai | anthropic
# Leave as placeholder to use rule-based fallback (no cost, no API key needed)
AI_PROVIDER=openai
AI_API_KEY=replace_with_api_key
AI_MODEL=gpt-4o-mini

# ── Vector DB (Qdrant) ───────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=medical_knowledge
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384
TOP_K=5

# ── Redis (caching + conversation memory) ───────────────────────────
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=300

# ── Node backend URL (for tools that call Node APIs) ────────────────
NODE_URL=http://localhost:5004

# ── Prompt versioning ────────────────────────────────────────────────
# Active prompt version — health_agent_v1.txt or health_agent_v2.txt
PROMPT_VERSION=health-awareness-v2

# ── Service ──────────────────────────────────────────────────────────
APP_ENV=development
PORT=8000
