# ── Server ─────────────────────────────────────────────────────────
PORT=5004
NODE_ENV=development

# ── Auth ────────────────────────────────────────────────────────────
# MUST match ai-service JWT_SECRET exactly — shared secret for token validation
JWT_SECRET=change_me_strong_secret_min_32_chars

# ── Databases ───────────────────────────────────────────────────────
POSTGRES_URI=postgresql://postgres:postgres@localhost:5433/public_health
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/healthbot?retryWrites=true&w=majority&appName=Cluster0
REDIS_URL=redis://localhost:6379

# ── AI Provider (used by Node fallback ai.service.js) ───────────────
# Supported: openai | anthropic
AI_PROVIDER=openai
AI_API_KEY=replace_with_api_key
AI_MODEL=gpt-4o-mini

# Python AI microservice URL (Phase 4+)
AI_SERVICE_URL=http://localhost:8000

# ── CORS ────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ── DB startup retry (for Docker health-check timing) ───────────────
DB_STARTUP_RETRIES=15
DB_STARTUP_DELAY_MS=4000

# ── Web Push Notifications (VAPID) ──────────────────────────────────
# Generate once with: node -e "const wp=require('web-push');const k=wp.generateVAPIDKeys();console.log(JSON.stringify(k))"
# Then set both keys here. Never regenerate — all existing subscriptions will break.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@healthguide.local
